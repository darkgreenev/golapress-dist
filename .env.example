APP_NAME=goLaPress
APP_ENV=development
APP_URL=http://localhost:8076
APP_HOST=0.0.0.0
APP_PORT=8076
APP_SITE_DIR=./my-site
APP_SITE_GIT_INIT=true
APP_UPDATE_LATEST_URL=https://raw.githubusercontent.com/darkgreenev/golapress-dist/main/latest.json
AI_PROVIDER=rapidapi_chat
AI_MODEL=gpt-5-mini
RAPIDAPI_BASE_URL=https://chatgpt-4-api.p.rapidapi.com/chat
RAPIDAPI_HOST=chatgpt-4-api.p.rapidapi.com
RAPIDAPI_KEY=
SMTP_RELAY_URL=https://www.everlive.net/tools0x/2026/smtp-relay/index.php
SMTP_RELAY_TOKEN=
DB_DRIVER=mysql
DB_DSN=golapress:golapress@tcp(mysql:3306)/golapress?parseTime=true&charset=utf8mb4,utf8
# Example local SQLite DSN:
# DB_DRIVER=sqlite
# DB_DSN=file:./my-site/data/golapress.db?_foreign_keys=on
MEDIA_DIR=./my-site/data/media
PLUGINS_DIR=./my-site/plugins
THEMES_DIR=./my-site/themes
APP_DEV_RELOAD_ENABLED=true
# Forwarded client IP headers are only honored when both settings are configured.
APP_TRUSTED_PROXY_HEADERS=false
# Examples:
# APP_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# APP_TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
APP_TRUSTED_PROXY_CIDRS=
ENABLED_PLUGINS=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-real-deployments
ADMIN_DISPLAY_NAME=Admin
SESSION_COOKIE_NAME=golapress_session
SESSION_TTL=24h
CODEX_AI_ENABLED=false
CODEX_RUNTIME=local
# Leave blank to use the Codex CLI default model for the signed-in account.
CODEX_MODEL=
CODEX_API_KEY=
