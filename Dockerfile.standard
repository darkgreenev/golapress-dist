FROM debian:bookworm-slim

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies: Git, Curl, CA-Certificates, and Tar
RUN apt-get update && apt-get install -y \
    git \
    curl \
    ca-certificates \
    tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entrypoint script
COPY scripts/standard-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Default environment variables
ENV APP_HOST=0.0.0.0
ENV APP_PORT=8076
ENV APP_SITE_DIR=/app
ENV APP_SITE_GIT_INIT=true
ENV DB_DRIVER=mysql
ENV DB_DSN=golapress:golapress@tcp(host.docker.internal:3306)/golapress?parseTime=true&charset=utf8mb4,utf8

# Expose the application port
EXPOSE 8076

# Set the entrypoint
ENTRYPOINT ["entrypoint.sh"]
