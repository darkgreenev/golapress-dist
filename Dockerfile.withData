FROM ubuntu:22.04

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies: MySQL, Git, Curl, CA-Certificates, and Tar
RUN apt-get update && apt-get install -y \
    mysql-server \
    git \
    curl \
    ca-certificates \
    tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entrypoint script
COPY scripts/with-data-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Default environment variables for the trial
ENV MYSQL_DATABASE=golapress_trial
ENV MYSQL_USER=golapress
ENV MYSQL_PASSWORD=golapress
ENV ADMIN_PASSWORD=admin12345
ENV APP_ENV=production
ENV APP_SITE_DIR=/app
ENV APP_SITE_GIT_INIT=true
ENV APP_DEV_RELOAD_ENABLED=false
ENV APP_HOST=0.0.0.0
ENV APP_PORT=8076

# Expose the application port
EXPOSE 8076

# Set the entrypoint
ENTRYPOINT ["entrypoint.sh"]
